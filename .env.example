# Google Maps is optional for local previews. Without these values, the site
# shows the buyer-friendly map fallback and keeps the building list available.
VITE_GOOGLE_MAPS_API_KEY=

# Required for Google Maps Advanced Markers. If this is blank, local/preview
# maps intentionally use the legacy marker fallback when an API key is present.
VITE_GOOGLE_MAPS_MAP_ID=

# Optional 3D/map provider token for experiments; leave blank unless needed.
VITE_CESIUM_ION_TOKEN=
