# Google Maps is optional for local previews. Add the restricted browser key in
# your local/deploy environment only. Never commit the real value.
VITE_GOOGLE_MAPS_API_KEY=

# Add the JavaScript vector Map ID for the published WPB Editorial Waterfront
# cloud style. If blank, previews use the legacy marker fallback.
VITE_GOOGLE_MAPS_MAP_ID=

# Optional 3D/map provider token for experiments; leave blank unless needed.
VITE_CESIUM_ION_TOKEN=

# Cloudflare Turnstile public site key. The secret belongs in Cloudflare Pages Functions secrets.
VITE_TURNSTILE_SITE_KEY=

# Optional GA4 web-stream measurement ID. Keep blank until the production
# property, consent requirements, and DebugView verification are complete.
VITE_GA4_MEASUREMENT_ID=

# Server-side lead capture configuration is intentionally not placed in this file:
# LEADS_DB (Cloudflare Pages D1 binding)
# TURNSTILE_SECRET_KEY
# RESEND_API_KEY
# LEAD_RETRY_TOKEN
# LEAD_HASH_SALT
# LEAD_NOTIFICATION_EMAIL (defaults to Brooke's Gmail)
# LEAD_FROM_EMAIL (defaults to concierge@wpbnewconstruction.com)
