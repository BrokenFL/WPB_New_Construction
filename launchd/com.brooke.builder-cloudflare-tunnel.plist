<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.brooke.builder-cloudflare-tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cloudflared tunnel --config /Users/brookesnader/.cloudflared/brooke-builder.yml run</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/brooke-builder-cloudflared.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/brooke-builder-cloudflared.err</string>
</dict>
</plist>
