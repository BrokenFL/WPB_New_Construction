{
  "name": "new-construction",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "postbuild": "node research/scripts/prerender-static-routes.mjs",
    "preview": "vite preview",
    "qa:launch": "node research/scripts/qa-launch-readiness.mjs && npm run qa:public-json && npm run qa:a11y-forms && npm run qa:performance && npm run qa:image-mapping && npm run qa:news-images && npm run qa:project-pages && npm run qa:project-logos && npm run qa:approved-news && npm run qa:customer-copy && npm run qa:seo && npm run qa:image-alt && npm run qa:internal-links",
    "qa:gatekeeper": "node research/scripts/qa-gatekeeper-surface.mjs",
    "qa:public-json": "node research/scripts/check-public-json-safety.mjs",
    "qa:a11y-forms": "node research/scripts/check-form-accessibility.mjs",
    "qa:performance": "node research/scripts/check-performance-budget.mjs",
    "qa:image-mapping": "node research/scripts/check-image-mapping.mjs",
    "qa:news-images": "node research/scripts/check-news-image-mapping.mjs",
    "qa:project-pages": "node research/scripts/check-project-page-completeness.mjs",
    "qa:project-logos": "node research/scripts/check-project-logos.mjs",
    "qa:approved-news": "node research/scripts/check-approved-news.mjs",
    "qa:customer-copy": "node research/scripts/check-customer-facing-copy.mjs",
    "qa:seo": "node research/scripts/check-seo-readiness.mjs",
    "qa:image-alt": "node research/scripts/check-image-alt-quality.mjs",
    "qa:internal-links": "node research/scripts/check-internal-links.mjs",
    "deploy:live": "node research/scripts/deploy-live-site.mjs",
    "ship:live": "npm run build && npm run qa:launch && npm run qa:gatekeeper && npm run deploy:live",
    "research:site-intelligence": "node research/scripts/build-site-intelligence.mjs",
    "maps:home": "node research/scripts/generate-home-coordinate-map.mjs",
    "news:refresh": "node research/scripts/build-site-intelligence.mjs",
    "news:fetch": "node research/scripts/fetch-development-news.mjs",
    "news:promote": "node research/scripts/promote-approved-news.mjs",
    "import:developer-images": "node research/scripts/import-developer-interior-images.mjs",
    "review:developer-images": "node research/scripts/review-imported-project-images.mjs",
    "assets:place-developer-images": "node research/scripts/place-developer-project-images.mjs",
    "assets:duplicates": "node research/scripts/report-duplicate-assets.mjs --write",
    "assets:cleanup-approved": "node research/scripts/apply-approved-asset-cleanup.mjs --write",
    "assets:plan-resize": "npm run research:site-intelligence && node research/scripts/prepare-image-captions-and-sizes.mjs && node research/scripts/plan-authorized-asset-resize.mjs --write",
    "editor": "node research/scripts/local-content-editor.mjs",
    "editor:sync": "node research/scripts/sync-editor-overrides.mjs",
    "test": "npm run qa:launch && npm run qa:gatekeeper",
    "lint": "node research/scripts/lint-public-surface.mjs",
    "check:updates": "node research/scripts/check-imported-updates.mjs"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.0.9"
  }
}
